# ── Face Recognition Settings ────────────────────────────────
CONFIDENCE_THRESHOLD=0.5     # 0.3 (lenient) to 0.7 (strict)
DETECTION_MODEL=hog          # hog (CPU, faster) | cnn (GPU, accurate)
FRAME_SKIP=3                 # Process every Nth frame (higher = faster)
RESIZE_SCALE=0.25            # Downscale for processing (lower = faster)
MAX_FACES_PER_FRAME=10

# ── Storage ───────────────────────────────────────────────────
KNOWN_FACES_DIR=known_faces
ATTENDANCE_LOG=attendance_log.csv

# ── Camera ────────────────────────────────────────────────────
CAMERA_SOURCE=0              # 0 = default webcam, 1 = external camera
